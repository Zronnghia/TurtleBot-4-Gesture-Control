<?xml version="1.0"?>
<sdf version='1.8'>
    <world name='gesture_arena'>
        <physics name='1ms' type='ignored'>
            <max_step_size>0.003</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>
        <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
        <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
        <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />
        <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system' />
        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.90000000000000002</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
            <spot>
                <inner_angle>0</inner_angle>
                <outer_angle>0</outer_angle>
                <falloff>0</falloff>
            </spot>
        </light>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type='adiabatic' />
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>1</shadows>
        </scene>
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode />
                        </friction>
                        <bounce />
                        <contact />
                    </surface>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                    <plugin name='__default__' filename='__default__' />
                </visual>
            </link>
            <plugin name='__default__' filename='__default__' />
            <pose>0 0 0 0 -0 0</pose>
        </model>


        <!-- tb4_lab04 (Bai 6): san 9 m x 9 m, khong vat can ben trong. Robot spawn o (0,0) trong dock,
             undock xong dung o ~(-0.35, 0) quay ve huong -x; moi hanh vi cu chi deu nam trong vong tron
             ban kinh ~1.5 m quanh diem do -> cach tuong >= 2.5 m. Vach tron tren san chi la dau hieu
             (khong co collision). -->
        <model name='arena_border'>
            <static>true</static>
            <link name='wall_north'>
                <pose>-1.5 4.55 0.3 0 0 0</pose>
                <collision name='c'><geometry><box><size>9.2 0.1 0.6</size></box></geometry></collision>
                <visual name='v'><geometry><box><size>9.2 0.1 0.6</size></box></geometry>
                    <material><ambient>0.55 0.6 0.7 1</ambient><diffuse>0.55 0.6 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
            </link>
            <link name='wall_south'>
                <pose>-1.5 -4.55 0.3 0 0 0</pose>
                <collision name='c'><geometry><box><size>9.2 0.1 0.6</size></box></geometry></collision>
                <visual name='v'><geometry><box><size>9.2 0.1 0.6</size></box></geometry>
                    <material><ambient>0.55 0.6 0.7 1</ambient><diffuse>0.55 0.6 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
            </link>
            <link name='wall_west'>
                <pose>-6.05 0.0 0.3 0 0 0</pose>
                <collision name='c'><geometry><box><size>0.1 9.0 0.6</size></box></geometry></collision>
                <visual name='v'><geometry><box><size>0.1 9.0 0.6</size></box></geometry>
                    <material><ambient>0.55 0.6 0.7 1</ambient><diffuse>0.55 0.6 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
            </link>
            <link name='wall_east'>
                <pose>3.05 0.0 0.3 0 0 0</pose>
                <collision name='c'><geometry><box><size>0.1 9.0 0.6</size></box></geometry></collision>
                <visual name='v'><geometry><box><size>0.1 9.0 0.6</size></box></geometry>
                    <material><ambient>0.55 0.6 0.7 1</ambient><diffuse>0.55 0.6 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
            </link>
        </model>
        <model name='work_zone'>
            <static>true</static>
            <pose>-1.4 0.0 0.001 0 0 0</pose>
            <link name='link'>
                <visual name='v'><geometry><cylinder><radius>1.6</radius><length>0.002</length></cylinder></geometry>
                    <material><ambient>0.86 0.90 0.80 1</ambient><diffuse>0.86 0.90 0.80 1</diffuse></material></visual>
            </link>
        </model>
    </world>
</sdf>
